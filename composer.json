{
	"name": "automattic/jetpack-mu-wpcom",
	"description": "Enhances your site with features powered by WordPress.com",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"_comment": [
		"Dependency on symfony/filesystem is so scssphp/scssphp doesn't bring in 7.x which requires PHP 8.2."
	],
	"require": {
		"php": ">=8.1",
		"automattic/block-delimiter": "^0.3.8",
		"automattic/jetpack-agents-manager": "^0.8.2-alpha",
		"automattic/jetpack-assets": "^4.4.6-alpha",
		"automattic/jetpack-blocks": "^3.3.5",
		"automattic/jetpack-classic-theme-helper": "^0.14.37-alpha",
		"automattic/jetpack-compat": "^4.0.4",
		"automattic/jetpack-connection": "^8.7.9-alpha",
		"automattic/jetpack-device-detection": "^3.4.5",
		"automattic/jetpack-google-analytics": "^0.3.5-alpha",
		"automattic/jetpack-masterbar": "^0.27.34-alpha",
		"automattic/jetpack-podcast": "^1.4.0",
		"automattic/jetpack-redirect": "^3.0.15",
		"automattic/jetpack-rtc": "^0.2.0-alpha",
		"automattic/jetpack-stats-admin": "^0.31.9",
		"automattic/jetpack-status": "^6.1.9",
		"automattic/jetpack-wp-build-polyfills": "^0.2.3-alpha",
		"automattic/scheduled-updates": "^0.14.7-alpha",
		"scssphp/scssphp": "2.1.0",
		"symfony/filesystem": "^6.0.0",
		"automattic/jetpack-explat": "^0.5.0-alpha"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"brain/monkey": "^2.6.2",
		"automattic/phpunit-select-config": "^1.0.9"
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-js": "pnpm run test",
		"test-js-coverage": "pnpm run test-coverage",
		"test-php": "@composer phpunit",
		"test-php-coverage": "php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\"",
		"build-production": "pnpm run build-production-js",
		"build-development": "pnpm run build-js",
		"watch": [
			"Composer\\Config::disableProcessTimeout",
			"pnpm run watch"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"mirror-repo": "Automattic/jetpack-mu-wpcom",
		"changelogger": {
			"link-template": "https://github.com/Automattic/jetpack-mu-wpcom/compare/v${old}...v${new}"
		},
		"autotagger": true,
		"branch-alias": {
			"dev-trunk": "6.11.x-dev"
		},
		"textdomain": "jetpack-mu-wpcom",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-jetpack-mu-wpcom.php"
		}
	},
	"config": {
		"allow-plugins": {
			"roots/wordpress-core-installer": true
		}
	}
}
